# Copy to .env and fill in the values. Never commit the .env file.

# ---------------------------------------------------------------- login
# keycloak                  browser login (authorization code flow with PKCE)
# keycloak_service_account  service account login (client credentials), for scheduled jobs
AUTH_METHOD=keycloak

KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
DELTA_SHARING_URL=

# Only required for keycloak_service_account (client credentials grant)
KEYCLOAK_CLIENT_SECRET=

# Optional: callback for the browser login (must be allowed in the Keycloak client), scope, timeout
# KEYCLOAK_REDIRECT_URI=http://localhost:8000/callback
# KEYCLOAK_SCOPE=openid
# KEYCLOAK_CALLBACK_TIMEOUT=180

# ---------------------------------------------------------------- data (all optional)
# Table the notebook opens first, as share.schema.table (default: the first table found)
DEFAULT_TABLE=
# Tables to compare in the notebook, comma-separated share.schema.table names
COMPARE_TABLES=
# Partition column to filter on (default: detected from the table metadata)
PARTITION_COLUMN=
# How it stores time: auto | epoch_seconds | epoch_millis | date | timestamp | string
PARTITION_FORMAT=auto
# Override the predicate value type if the server expects a different one (e.g. int instead of long)
PARTITION_VALUE_TYPE=
# For PARTITION_FORMAT=string: how dates are written, e.g. %Y-%m-%d or %Y%m%d
PARTITION_STRING_FORMAT=%Y-%m-%d
